# Provider credentials are server-only. Never expose them through VITE_* variables.
DASHSCOPE_API_KEY=
AGNES_API_KEY=
AGNES_API_BASE=https://apihub.agnes-ai.com/v1
ZHIPU_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
FREE_MODELS_ONLY=true
SUB2API_API_KEY=
SUB2API_GROK_BASE_URL=https://ctmoai.com/v1

# Keep this true for a public studio with no visitor key prompt. Provider keys stay server-only;
# per-client limits still apply to uploads, tasks, status checks, and downloads.
VIDEO_ACCESS_TOKEN=
VIDEO_ACCESS_DISABLED=true

# Per-client hourly limits. Increase only after adding user authentication.
VIDEO_CREATE_LIMIT_PER_HOUR=6
VIDEO_UPLOAD_LIMIT_PER_HOUR=30
VIDEO_STATUS_LIMIT_PER_HOUR=360
VIDEO_DOWNLOAD_LIMIT_PER_HOUR=12
